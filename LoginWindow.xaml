<Window x:Class="Demo.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Чудо Обувь" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ColorMain}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="Images/Чудо Обувь.png" Width="200" Height="150" Stretch="Uniform" Margin="0,0,0,20"/>
            <TextBlock Text="Выберите пользователя:" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <ComboBox x:Name="ComboUsers" Width="250" Height="30" Margin="0,0,0,20" FontSize="14"/>
            <Button x:Name="BtnLogin" Content="Войти" Width="250" Height="40" 
                    Background="{StaticResource ColorAccent}" Foreground="White" 
                    FontSize="16" FontWeight="Bold" BorderThickness="0" Click="BtnLogin_Click"/>
            <Button x:Name="BtnGuest" Content="Войти как гость (Каталог)" Width="250" Height="40" 
                    Background="{StaticResource ColorSecondary}" Foreground="Black" 
                    FontSize="14" Margin="0,10,0,0" BorderThickness="0" Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>