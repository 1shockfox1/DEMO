<Application x:Class="Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ColorMain" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ColorSecondary" Color="#D2F6E7" />
        <SolidColorBrush x:Key="ColorAccent" Color="#70B2AF" />
        <SolidColorBrush x:Key="ColorWarning" Color="#FF8080" />
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Calibri"/>
        </Style>
    </Application.Resources>
</Application>